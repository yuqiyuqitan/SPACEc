# SPACEc publication style
# Calibrated for Nature / Cell journals:
#   single column 89 mm (3.50 in), double column 183 mm (7.20 in)
#   7-8 pt fonts, 300 DPI raster / 600 DPI line-art
#
# Usage:
#   import matplotlib.pyplot as plt
#   plt.style.use("spacec_publication")

# --- Typography ---
font.family:        sans-serif
font.size:          7
axes.titlesize:     8
axes.labelsize:     7
xtick.labelsize:    6
ytick.labelsize:    6
figure.titlesize:   10

# --- Ticks ---
xtick.direction:    in
ytick.direction:    in
xtick.major.size:   3.0
ytick.major.size:   3.0
xtick.major.width:  0.5
ytick.major.width:  0.5

# --- Lines ---
axes.linewidth:     0.75
lines.linewidth:    0.75
lines.markersize:   3
patch.linewidth:    0.75
patch.edgecolor:    1a1a1a

# --- Colors ---
axes.facecolor:     white
figure.facecolor:   white
axes.grid:          False

# --- Legend ---
legend.frameon:     False
legend.fontsize:    7
legend.markerscale: 1.0

# --- Save ---
figure.dpi:         300
savefig.dpi:        300
savefig.transparent: True
savefig.bbox:       tight
savefig.format:     pdf
